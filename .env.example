# ─────────────────────────────────────────────
# 에코 프로젝트 환경설정 예시
#
# 사용법:
#   1. 이 파일을 복사해서 이름을 .env 로 바꾼다  (PowerShell: Copy-Item .env.example .env)
#   2. .env 안의 값을 자기 것으로 채운다
#   3. .env 는 절대 공유하지 않는다 (.gitignore에 이미 들어 있음)
# ─────────────────────────────────────────────

# Google AI Studio에서 발급한 Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=여기에_본인_키

# 사용할 모델 (바꿀 일 없으면 그대로)
# 2026-09 기준: gemini-2.5-flash 는 신규 키에서 막혀 있음 → gemini-3.6-flash 사용
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ─── LLM 제공자 (backend/llm.py) ───
# gemini(기본) | claude(Anthropic API) | local(강의실 서버의 Ollama/vLLM). claude·local 은 Gemini 대체 + 비교 실험용
# LLM_BACKEND=gemini
# Claude: console.anthropic.com 에서 키 발급. 무료 등급 없음 (선불 크레딧). 모델 단가는 platform.claude.com/docs/en/pricing
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_CLAUDE_MODEL=claude-opus-5
# OpenAI 호환 엔드포인트는 이름을 붙여 여러 개 등록 (강의실 서버 Ollama, Groq, Mistral, OpenRouter, Cerebras … 규격이 같음)
# LLM_ENDPOINTS=groq,teacher
# LLM_GROQ_URL=https://api.groq.com/openai/v1
# LLM_GROQ_KEY=gsk_...
# LLM_GROQ_MODEL=openai/gpt-oss-20b
# LLM_TEACHER_URL=http://<선생님서버IP>:11434/v1
# LLM_TEACHER_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT=30
# LLM_FALLBACK=1
#
# 강의실 서버(Ollama, 같은 네트워크면 IP로 바로 접속됨) 실제 예시. LLM_BACKEND=local 이면 /fix·/ask 가 씀.
# 아직 기능 개선 중 — 문제 생기면 LLM_BACKEND=gemini 로 바꾸면 원래 경로로 돌아감(자동 폴백도 있음)
# LLM_BACKEND=local
# LLM_LOCAL_URL=http://192.168.1.147:11434/v1
# LLM_LOCAL_MODEL=qwen2.5:14b-instruct
#
# 챗봇 마이크(hybrid_stt) 병합 전용 — 14b 는 이 자유 재구성 작업에서 불안정해서(단어 소실·오역 관찰됨)
# 32b 로 따로 지정. backend/speak.py 가 이 이름("merge32b")을 코드에서 그대로 참조하니 이름은 바꾸지 말 것
# LLM_ENDPOINTS=merge32b
# LLM_MERGE32B_URL=http://192.168.1.147:11434/v1
# LLM_MERGE32B_MODEL=qwen2.5:32b-instruct

# 앱 설정
APP_TITLE=에코
LEARNER_NAME=지수
AUDIO_CACHE_DIR=audio_cache

# 로컬 Whisper STT(STT_BACKEND=whisper, 챗봇 마이크의 hybrid_stt 등)가 쓰는 모델 크기.
# 기본값 base(~145MB, 첫 실행 때 자동 다운로드). small은 인식 정확도가 낫지만 3배 느리고
# 용량도 더 큼(~500MB) — 정확도가 더 필요하면 WHISPER_MODEL=small 로 바꿀 수 있음.
# WHISPER_MODEL=base

# 강의실 서버(GPU)에서 Whisper 돌리기(backend/whisper_server.py, nohup으로 띄워둠).
# 로컬 CPU(수 초)보다 훨씬 빠름(0.3~0.4초). 안 닿으면 자동으로 로컬 CPU로 폴백.
# WHISPER_SERVER_URL=http://192.168.1.147:8001

# ─── 임베딩 모델 비교(참고용 — 여기 .env 설정이 아니라 커맨드라인으로 실행) ───
# backend/embedding.py(RAG 담당 확정 모델, gemini-embedding-001)는 안 건드리고, 실행 중에만
# 바꿔치기해서 gemini/local/remote 세 백엔드의 hit@1·hit@3 을 비교해보는 도구가 있음:
#   python -m tests.embedding_backend_compare --backend gemini
#   python -m tests.embedding_backend_compare --backend local --model intfloat/multilingual-e5-base
#   python -m tests.embedding_backend_compare --backend remote --url http://192.168.1.147:8002 --model BAAI/bge-m3
# remote 는 강의실 서버에 backend/embed_server.py 를 whisper_server.py처럼 nohup으로 띄워둔 것을 씀.
# 자세한 사용법은 tests/embedding_backend_compare.py 파일 맨 위 설명 참고.
